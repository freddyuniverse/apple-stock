<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: edit the paths, copy to ~/Library/LaunchAgents/, then
     launchctl load ~/Library/LaunchAgents/com.apple-stock.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.apple-stock</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/apple-stock</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/npm</string>
    <string>start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/apple-stock.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/apple-stock.log</string>
</dict>
</plist>
