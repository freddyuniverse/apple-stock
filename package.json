{
  "name": "apple-stock",
  "version": "0.1.0",
  "description": "Get pinged when an Apple product is available for in-store pickup or 2-hour courier delivery near you.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "check": "node --env-file-if-exists=.env src/index.js --once",
    "test-notify": "node --env-file-if-exists=.env src/index.js --test-notify",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
