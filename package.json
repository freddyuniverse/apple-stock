    "test-notify": "node --env-file-if-exists=.env src/index.js --test-notify",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "drizzle-orm": "^0.45.4",
